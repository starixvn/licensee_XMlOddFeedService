<?xml version="1.0"?>
<configuration>
    <configSections>
        <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
        <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
        <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
    </configSections>

    <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension" resourcePath="App_Data/SpNames.xml" enableWatching="0" />
        </providers>
    </Fanex.Data.DbSettingProvider>
    <Fanex.Logging msmqPath="FormatName:DIRECT=http://172.16.4.106/msmq/Private$/entlib" defaultCategory="XML-Odds-Feed-Service-SIT" />

    <appSettings>
        <add key="Interval" value="20" />
        <add key="NumTries" value="5" />
        <add key="TotalVersion" value="17" />
        <!-- in milisecond and % 1000 = 0-->
        <add key="MaxTimeRangeLive" value="300" />
        <!--in second-->
        <add key="MaxTimeRangeDeadball" value="120" />
        <!--in second-->
        <add key="MaxTimeRangeOutright" value="120" />
        <!--in second-->
        <add key="SP.Live" value="true" />
        <add key="SP.Suffix" value="" />
        <!--Url use for checking downtime-->
        <add key="ClientSettingsProvider.ServiceUri" value="" />
        <add key="Cache.Prefix" value="apollo" />
        <add key="FromMail" value="sb1@1100011.com" />
        <add key="ToMail" value="quinn.vo@starixsoft.com" />
        <add key="CCMail" value="" />
        <add key="BCCMail" value="" />

        <add key="app_mail_address" value="net.tcp://172.16.4.106:8585/MailService" />
        <add key="app_mail_id" value="18" />
        <add key="mailTo" value="" />

        <add key="Environment" value="SIT" />
        <add key="BetTypeSchemaPath" value="BetTypeSchema\BetTypes.json" />
        <add key="BetTypeSchemaKey" value="BetTypeSchemaKey" />
        <add key="Bucket.OddsFeed" value="oddsfeed" />
        <add key="Bucket.Outrights" value="outrights" />
        <add key="Bucket.LiveMatches" value="livematches" />
        <add key="Bucket.DeadMatches" value="deadmatches" />
    </appSettings>
    <connectionStrings>
        <add name="DBACC.bodb02.bodbAdminNet" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=172.16.40.13;Initial Catalog=bodb02;integrated security=false; user id=bodbAdminNet; password=j+UGweaEw4d2X3mfHMROgA==;" />
    </connectionStrings>

    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>

    <ONEbook.UM ServiceUris="http://172.16.4.106:8889/api" EnableCheckUM="true"
                EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000007"
                UMPageUrl="~/UserLogin/Common/Offline">
        <AllowedIPs AllowAll="true">
        </AllowedIPs>
    </ONEbook.UM>
    <runtime>
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <dependentAssembly>
                <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-9.0.0.0" newVersion="9.0.0.0" />
            </dependentAssembly>
            <dependentAssembly>
                <bindingRedirect oldVersion="0.0.0.0-2.5.0.0" newVersion="2.5.0.0" />
            </dependentAssembly>
            <dependentAssembly>
                <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
            </dependentAssembly>
            <dependentAssembly>
                <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-4.0.0.1" newVersion="4.0.0.1" />
            </dependentAssembly>
            <dependentAssembly>
                <assemblyIdentity name="System.Runtime.InteropServices.RuntimeInformation" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
                <bindingRedirect oldVersion="0.0.0.0-4.0.1.0" newVersion="4.0.1.0" />
            </dependentAssembly>
        </assemblyBinding>
    </runtime>
</configuration>