<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
        <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
        <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
    </configSections>

    <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension" resourcePath="App_Data/SpNames.xml" enableWatching="0" />
        </providers>
    </Fanex.Data.DbSettingProvider>

    <appSettings>
        <add key="Interval" value="60" />
        <add key="TotalVersion" value="7" />
        <!-- in milisecond and % 1000 = 0-->
        <add key="MaxTimeRangeLive" value="300" />
        <!--in second-->
        <add key="MaxTimeRangeDeadball" value="120" />
        <!--in second-->
        <add key="MaxTimeRangeOutright" value="120" />
        <!--in second-->
        <!--Url use for checking downtime-->
        <add key="ClientSettingsProvider.ServiceUri" value="" />
        <add key="Cache.Prefix" value="apollo" />
        <add key="Environment" value="Local" />
        <add key="BetTypeSchemaPath" value="BetTypeSchema\BetTypes.json" />
        <add key="BetTypeSchemaKey" value="BetTypeSchemaKey" />
        <add key="Bucket.OddsFeed" value="oddsfeed" />
        <add key="Bucket.Outrights" value="outrights" />
        <add key="Bucket.LiveMatches" value="livematches" />
        <add key="Bucket.DeadMatches" value="deadmatches" />
        <!--results feed-->
        <add key="ResultFeed.Interval" value="5" />
        <add key="ResultFeed.TotalVersion" value="6" />
        <add key="ResultFeed.Bucket" value="resultfeed" />
        <add key="ResultFeed.BucketData" value="resultfeed_data" />

        <add key="RedisHost" value="10.18.200.131:16379,password=foo1@bared,defaultDatabase=7" />
        <add key="SentryCategory" value="oddsfeed-winservice" />
        <add key="SentryDNS" value="http://2b65d7ea8c4c4066b16ead9178b7498c@10.18.200.131:800/64" />
    </appSettings>
    <connectionStrings>
        <add name="DBACC.bodb02.bodbAdminNet" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.18.200.56;Initial Catalog=bodb02;integrated security=false; user id=bodbAdminNet;Asynchronous Processing=true; password=i9hNnaZltx04XF6oTNOKTnvvtLC/zfxr;" />
    </connectionStrings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>
    <ONEbook.UM ServiceUris="http://10.18.200.124:8889/api" EnableCheckUM="false" EnableUnscheduledUM="false" UMFrom="03:00" UMTo="04:00" SiteId="2000007" UMPageUrl="~/UserLogin/Common/Offline">
        <AllowedIPs AllowAll="true">
        </AllowedIPs>
    </ONEbook.UM>
