<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>504b63a6-54b1-4b95-a543-abbeca033813</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="wwwroot\scss\ie.scss" />
    <Content Remove="wwwroot\scss\print.scss" />
    <Content Remove="wwwroot\scss\screen.scss" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="App_Data\SpNames.xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Data\SpNames.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fanex.OddsFeed.Core\Fanex.OddsFeed.Core.csproj" />
    <ProjectReference Include="..\Fanex.OddsFeed.Web.Services\Fanex.OddsFeed.Web.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\minify\css\" />
    <Folder Include="wwwroot\minify\js\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\scss\ie.scss" />
    <None Include="wwwroot\scss\print.scss" />
    <None Include="wwwroot\scss\screen.scss" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BuildBundlerMinifier" Version="3.2.449" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="nlog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
