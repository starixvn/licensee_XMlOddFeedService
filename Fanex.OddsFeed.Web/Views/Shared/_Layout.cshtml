<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/Site.css" />
    @RenderSection("Styles", false)
</head>
<body>
    <
    <div class="page">
        <header>
            <div id="title">
                <h1>Odds feed system monitoring services</h1>
            </div>
            <div id="logindisplay">
                <partial name="_LogOnPartial" />
            </div>
            <nav>
                <ul id="menu">
                    <li>@Html.ActionLink("Cache", "Cache", "Analytics")</li>
                    <li>@Html.ActionLink("Email", "Email", "Analytics")</li>
                </ul>
            </nav>
        </header>
        <section id="main">
            @RenderBody()
        </section>
        <footer>
        </footer>
    </div>
    <script src="~/lib/jquery-1.5.1.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>