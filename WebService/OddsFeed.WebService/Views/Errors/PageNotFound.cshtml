@{ 
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>XML ODDS FEED - Page Not Found</title>
    <style media="screen" type="text/css">
        body
        {
            margin: 0px 0px;
            padding: 0px;
            text-align: left;
            font-family: Tahoma;
     
        }
        .pageheader
        {
            background: #000 url("css/images/top-bg.png") repeat;
            height: 46px;
            border-top: 1px solid #f5f5f5;
            border-bottom: 1px solid #898989;
            padding-left: 19px;
            padding-right: 15px;
            vertical-align: middle;
        }
    </style>
</head>
<body>
    <div class="pageheader">
    </div>
    <div style="text-align: center; margin-top:50px;">
        <div>
            <div>
                <img src="~/css/images/tp_404error.png" />
                <br />
            </div>
            <table width="100%">
                <tr align="center">
                    <td align="right"><img src="~/css/images/tp_exclamation.png" /></td>
                    <td align="left" style="width:60%; font-size: 50px; color: #0072bc; vertical-align:middle;"> PAGE NOT FOUND</td>
                </tr>
            </table>
            <br /><br />
            <div>
                <span style="font-size: 12px;">Sorry, the page you were looking for appears to have been moved, deleted or does not exist.</span>
                <br /><br />
            </div>
        </div>
    </div>
    <footer>
    </footer>
</body>
</html>