@using OddsFeed.Models.DTO
@using OddsFeed.Models.Data
@using OddsFeed.Models.Schemas
@using OddsFeed.WebService.Extensions

@model UserProfile
@{
    Layout = null;
    var highlightSportType = (string[])ViewBag.HighlightSportType;
    var highlightBetType = (string[])ViewBag.HighlightBetType;
    var betTypeList = (IDictionary<int, BetType>)ViewBag.BetTypeList;
    var betTypeDescriptions = (IList<BetTypeDescription>)ViewBag.BetTypeDescriptions;
    string baseUrl = string.Format("{0}/{1}{2}", Model.Domain, ViewBag.VirtualPath, ViewBag.UserName);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Odds feed user manual</title>
    <link rel="stylesheet" href="~/minify/css/help.min.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        <div class="content_wrap">
            <section id="section_breadcrumb">
                <div id="header" class="separator js-separator">
                    <partial name="_Menu" />
                </div>
            </section>
            <section id="section_body" class="content_scroll">
                <div id="div_get_started" class="section">
                    <div class="title">
                        <span style="margin-left: 10px"></span>GETTING STARTTED
                    </div>
                    @if (Model.OddsType.Contains(4))
                    {
                        <div class="content">
                            Odds feed is an automated service which enables your betting system or website access
                            to our Live Odds on all major sporting events through XML Odds feed. This service
                            is already being used successfully by other customers who confidently give their
                            full approval and praise the time savings and accuracy of the content.
                        </div>
                    }
                    else
                    {
                        <div class="content">
                            Odds feed is an automated service which enables your betting system or website access
                            to our Odds data on all major sporting events through XML Odds feed. This service
                            is already being used successfully by other customers who confidently give their
                            full approval and praise the time savings and accuracy of the content.
                        </div>
                    }
                    <div class="content">
                        <br />
                        This is a sample of our XML Odds Feeds that includes following fields:
                        <ul>
                            <li>Match ID</li>
                            <li>Match Kick-off time</li>
                            <li>League name/Team name</li>
                            <li>All major Sport type/ Bet Type</li>
                            <li>Odd ID/Price</li>
                        </ul>
                        <pre class="brush: xml">
                            <oddsfeed>
                                <matches lastupdate="6/27/2022 3:35:50 PM" timestamp="1656300722" oddstype="Malay">
                                    <match id="51266424" ge="Origin of MLB World Series 2022 Winner" gt="2022美國職業棒球大聯盟世界大賽 隊伍源自地" gs="2022美国职业棒球大联盟世界大赛 队伍源自地" he="American League" ht="美國聯盟" hs="美国聯盟" ae="National League" at="國家聯盟" as="国家联盟" mt="6/28/2022 7:04:59 AM" sport="Baseball" running="0">
                                        <bookie name="IBC" simp="IBC" trad="IBC">
                                            <odd t="ml" o1="0.97" o2="0.85" time="6/27/2022 1:28:13 PM" timestamp="1656293294"></odd>
                                        </bookie>
                                    </match>
                                </matches>
                            </oddsfeed>
                        </pre>
                    </div>
                    <br />
                    <div class="content">
                        <hr />
                        Results feed is an automated service which enables your betting system or website access
                        to our Results data on all major sporting events through XML Odds feed. This service
                        is already being used successfully by other customers who confidently give their
                        full approval and praise the time savings and accuracy of the content.
                    </div>
                    <div class="content">
                        <br />
                        This is a sample of our XML Results Feeds that includes following fields:
                        <ul>
                            <li>Match ID</li>
                            <li>Match Kick-off time</li>
                            <li>League name/Team name</li>
                            <li>All major Sport type</li>
                            <li>Results</li>
                        </ul>
                        <pre class="brush: xml">
                            <resultsfeed>
                                <matches date="7/7/2022 12:00:00 AM">
                                    <match id="54127053" ge="LANKA PREMIER LEAGUE1" gt="美國職業棒球大" gs="美国职业棒球大" he="Jaffna Stallions" ht="美國聯盟" hs="美国聯盟" ae="Colombo Kings" at="國家聯盟" as="国家联盟" mt="7/7/2022 12:09:00 AM" sport="cricket" complete="1">
                                        <bookie name="IBC" simp="IBC" trad="IBC">
                                            <result h1="242" a1="285" h2="124" a2="183" h="0" a="1"></result>
                                        </bookie>
                                    </match>
                                </matches>
                            </resultsfeed>
                        </pre>
                    </div>
                    <div style="height: 20px"></div>
                </div>
                <div id="div_general_concepts" class="section">
                    <div class="title">
                        <span style="margin-left: 10px"></span>How to Implement
                    </div>
                    <div id="div_term_definition" class="content general_concepts">
                        <div id="div_term_definition_match" class="sub-general-concepts">
                            <span class="sub_title">TERM AND DEFINITION FOR MATCH</span>
                            <hr />
                            <ul>
                                <li>Lastupdate: last request date for Odds data. </li>
                                <li>Timestamp: last request date convert to integer number. </li>
                                <li>ge: Event\League name in English. </li>
                                <li>gs: Event\League name in Chinese Simplified. </li>
                                <li>gt: Event\League name in Chinese Traditional. </li>
                                <li>gb: Event\League name in Bahasa Indonesia.</li>
                                <li>ga: Event\League name in Thai.</li>
                                <li>gk: Event\League name in Korean.</li>
                                <li>gv: Event\League name in Vietnamese.</li>
                                <li>gj: Event\League name in Japanese.</li>
                                <li>gh: Event\League name in Hindi.</li>
                                <li>he: Home team name in English. </li>
                                <li>hs: Home team name in Chinese Simplified. </li>
                                <li>ht: Home team name in Chinese Traditional. </li>
                                <li>hb: Home team name in Bahasa Indonesia.</li>
                                <li>ha: Home team name in Thai.</li>
                                <li>hk: Home team name in Korean.</li>
                                <li>hv: Home team name in Vietnamese.</li>
                                <li>hj: Home team name in Japanese.</li>
                                <li>hh: Home team name in Hindi.</li>
                                <li>ae: Away team name in English. </li>
                                <li>as: Away team name in Chinese Simplified. </li>
                                <li>at: Away team name in Chinese Traditional. </li>
                                <li>ab: Away team name in Bahasa Indonesia.</li>
                                <li>aa: Away team name in Thai.</li>
                                <li>ak: Away team name in Korean.</li>
                                <li>av: Away team name in Vietnamese.</li>
                                <li>aj: Away team name in Japanese.</li>
                                <li>ah: Away team name in Hindi.</li>
                                <li>mt: Match Kick-off time </li>
                                @if (Model.OddsType.Contains(4))
                                {
                                    <li>runing: Status (Live or Dead Ball) </li>
                                }
                                <li>bookie name: Provider of XML Odds Feed in English. </li>
                                <li>simp: Provider of XML Odds Feed in Chinese Simplified </li>
                                <li>trad: Provider of XML Odds Feed in Chinese Simplified </li>
                                <li>time: Display time for this odd. </li>
                                <partial name="GeneralConcepts/_BettypeDescription" />

                                @foreach (BetTypeDescription bettypeDesc in betTypeDescriptions)
                                {
                                    if (Model.BetTypes == null || Model.BetTypes.Contains(bettypeDesc.BetTypeId))
                                    {
                                        @await Html.PartialAsync("GeneralConcepts/_BettypeDesc", bettypeDesc)
                                    }
                                }
                            </ul>
                            <div style="color:Red">Note: When price is zero, it means we don't offer that bet choice.</div>
                            <div style="height: 20px"></div>
                        </div>
                        <div id="div_term_definition_bettype" class="sub-general-concepts">
                            <partial name="GeneralConcepts/_Outright" />
                        </div>
                    </div>
                    <div id="div_general_concepts_errors" class="content general_concepts">
                        <partial name="GeneralConcepts/_Errors"/>
                    </div>
                    <div id="div_general_concepts_result" class="content general_concepts">
                        @await Html.PartialAsync("GeneralConcepts/_Result", baseUrl)
                    </div>
                </div>
                <div id="div_commands" class="section">
                    <div class="title">
                        <span style="margin-left: 10px"></span>Commands
                    </div>
                    <div id="div_commands_general" class="content commands">
                        @await Html.PartialAsync("Commands/_Commands", baseUrl)
                    </div>
                    <div id="div_commands_timestamp" class="content commands">
                        <span class="sub_title">USING TIMESTAMP</span>
                        <hr />
                        To get the latest changes of Odds only, you need to specify the biggest timestamp
                        in your previous data request then input this parameter in the query string. Please,
                        note that this timestamp must be retrieved from child node only.
                        <br />
                        <a href="javascript:;">@baseUrl/odds.xml?t=[timestamp]</a>
                        <p>
                            <strong>Note</strong>: The biggest timestamp value is stored in timestamp attribute of <strong>matches</strong> node
                        </p>
                        <div>
                            <pre class="brush: xml;">
                                <oddsfeed>
                                    <matches lastupdate="6/27/2022 3:35:50 PM" timestamp="1656300722" oddstype="Malay">
                                        <match id="51266424" ge="Origin of MLB World Series 2022 Winner" gt="2022美國職業棒球大聯盟世界大賽 隊伍源自地" gs="2022美国职业棒球大联盟世界大赛 队伍源自地" he="American League" ht="美國聯盟" hs="美国聯盟" ae="National League" at="國家聯盟" as="国家联盟" mt="6/28/2022 7:04:59 AM" sport="Baseball" running="0">
                                            <bookie name="IBC" simp="IBC" trad="IBC">
                                                <odd t="ml" o1="0.97" o2="0.85" time="6/27/2022 1:28:13 PM" timestamp="1656293294"></odd>
                                            </bookie>
                                        </match>
                                    </matches>
                                </oddsfeed>
                            </pre>
                        </div>
                        <div style="height: 20px"></div>
                    </div>
                    <div id="div_commands_algorithm" class="content commands">
                        @await Html.PartialAsync("Commands/_UsingCompressionAlgorithrm", baseUrl)
                    </div>
                    <div id="div_commands_filters" class="content commands">
                        @await Html.PartialAsync("Commands/_Filters", baseUrl)
                    </div>
                </div>
                <div id="div_FAQ" class="section">
                    @await Html.PartialAsync("_FQAs", (string)ViewBag.ContactEmail)
                </div>
                <div id="div_change_log" class="section">
                    <partial name="_ChangeLog" />
                </div>
                <div id="div_appendix" class="section">
                    <div class="title">
                        <span style="margin-left: 10px"></span>APPENDIX
                    </div>
                    <div id="div_appendix_sports" class="content appendix" style="height: 100%">
                        <span class="sub_title">SUPPORTED SPORTS</span>
                        <hr />
                        Below is the list of supported sports in your xml data:
                        <div style="height: 20px">
                        </div>
                        <div style="display: inline-block;">
                            <div style="float: left; margin-right: 26px;">
                                <table style="width: 270px">
                                    <tr>
                                        <th style="width: 30%">SportID</th>
                                        <th>Sports Name</th>
                                    </tr>

                                    @foreach (var sport in ViewBag.SportsCol1)
                                    {
                                        var css1 = "";
                                        if (highlightSportType.Any(sportType => string.Equals(sportType, sport.SportId.ToString())))
                                        {
                                            css1 = "style=color:Red";
                                        }

                                        <tr @css1>
                                            <td class="center">@ViewHelper.GetSportId(sport)</td>
                                            <td>@sport.SportName</td>
                                        </tr>

                                    }
                                </table>
                            </div>
                            <div style="float: left; margin-right: 26px;">
                                <table style="width: 270px">
                                    @foreach (var sport in ViewBag.SportsCol2)
                                    {
                                        var css2 = "";
                                        if (highlightSportType.Any(sportType => string.Equals(sportType, sport.SportId.ToString())))
                                        {
                                            css2 = "style=color:Red";
                                        }

                                        <tr @css2>
                                            <td style="width: 30%" class="center">@ViewHelper.GetSportId(sport)</td>
                                            <td>@sport.SportName</td>
                                        </tr>
                                    }
                                </table>
                            </div>
                            <div style="float: left;">
                                <table style="width: 270px;">
                                    @foreach (var sport in ViewBag.SportsCol3)
                                    {
                                        var css3 = "";
                                        if (highlightSportType.Any(sportType => string.Equals(sportType, sport.SportId.ToString())))
                                        {
                                            css3 = "style=color:Red";
                                        }

                                        <tr @css3>
                                            <td style="width: 30%" class="center">@ViewHelper.GetSportId(sport)</td>
                                            <td>@sport.SportName</td>
                                        </tr>
                                    }
                                </table>
                            </div>
                        </div>
                        @{ var sportUrl = Model.Domain + "/" + ViewBag.VirtualPath + ViewBag.UserName + "/" + "sports.xml"; }
                        <div class="div_appendix_sports">
                            We also export the supported sport list into XML format, so that your development team can get and implement it dynamically. Please refer to the below information:
                            <pre class="brush: xml">
                                <sports>
                                    <sport id="1" se="Soccer" st="足球" ss="足球"></sport>
                                    <sport id="8" se="Basketball" st="籃球" ss="篮球"></sport>
                                    <sport id="4" se="Ice Hockey" st="冰上曲棍球" ss="冰上曲棍球"></sport>
                                    <sport id="5" se="Tennis" st="網球" ss="网球"></sport>
                                </sports>
                            </pre>
                        </div>
                        <div>
                            <div style="width:100%; padding-top: 15px;"><strong>Definition:</strong></div>

                            <ul>
                                <li>Link: <a target="_blank" href="@sportUrl">@sportUrl</a></li>
                                <li>id: Sport ID</li>
                                <li>se: Sport name in English</li>
                                <li>st: Sport name in Traditional Chinese</li>
                                <li>ss: Sport name in Simplified Chinese</li>
                                <li>sb: Sport name in Bahasa Indonesia</li>
                                <li>sa: Sport name in Thai</li>
                                <li>sk: Sport name in Korean</li>
                                <li>sv: Sport name in Vietnamese</li>
                                <li>sj: Sport name in Japanese</li>
                                <li>sh: Sport name in Hindi</li>
                            </ul>
                        </div>

                        <div style="height: 20px;"></div>
                    </div>
                    <div id="div_appendix_bettypes" class="content appendix">
                        <span class="sub_title">SUPPORTED BET TYPES</span>
                        <hr />
                        Below is the list of supported bet types in your xml data:
                        <div style="height: 20px">
                        </div>
                        <div style="display: inline-block;">
                            <div style="float: left; margin-right: 26px;">
                                <table style="width: 270px">
                                    <tr>
                                        <th style="width: 30%">BettypeID</th>
                                        <th>Bet Type</th>
                                        <th>XML value</th>
                                    </tr>
                                    @foreach (var bettype in ViewBag.BetTypesCol1)
                                    {
                                        var css4 = "";
                                        if (highlightBetType.Any(bt => string.Equals(bt, bettype.BetTypeId.ToString())))
                                        {
                                            css4 = "style=color:Red";
                                        }

                                        <tr @css4>
                                            <td class="center" valign="middle">
                                                <div class="bettype-inner-div">@bettype.BetTypeId</div>
                                            </td>
                                            <td>@bettype.BetTypeName</td>
                                            <td>@ViewHelper.GetBetTypeName(betTypeList, bettype.BetTypeId)</td>
                                        </tr>
                                    }
                                </table>
                            </div>
                            <div style="float: left; margin-right: 26px;">
                                <table style="width: 270px">
                                    @foreach (var bettype in ViewBag.BetTypesCol2)
                                    {
                                        var css5 = "";
                                        if (highlightBetType.Any(bt => string.Equals(bt, bettype.BetTypeId.ToString())))
                                        {
                                            css5 = "style=color:Red";
                                        }

                                        <tr @css5>
                                            <td style="width: 30%" class="center" valign="middle">
                                                <div class="bettype-inner-div">@bettype.BetTypeId</div>
                                            </td>
                                            <td>@bettype.BetTypeName</td>
                                            <td>@ViewHelper.GetBetTypeName(betTypeList, bettype.BetTypeId)</td>
                                        </tr>
                                    }
                                </table>
                            </div>
                            <div style="float: left;">
                                <table style="width: 270px;">
                                    @foreach (var bettype in ViewBag.BetTypesCol3)
                                    {
                                        var css6 = "";
                                        if (highlightBetType.Any(bt => string.Equals(bt, bettype.BetTypeId.ToString())))
                                        {
                                            css6 = "style=color:Red";
                                        }

                                        <tr @css6>
                                            <td style="width: 30%" class="center" valign="middle">
                                                <div class="bettype-inner-div">@bettype.BetTypeId</div>
                                            </td>
                                            <td>@bettype.BetTypeName</td>
                                            <td>@ViewHelper.GetBetTypeName(betTypeList, bettype.BetTypeId)</td>
                                        </tr>
                                    }
                                </table>
                            </div>
                        </div>
                        @{ var bettypeUrl = Model.Domain + "/" + ViewBag.VirtualPath + ViewBag.UserName + "/" + "bettypes.xml"; }
                        <div class="div_appendix_bettypes">
                            We also export the supported bet type list into XML format, so that your development team can get and implement it dynamically. Please refer to the below information:
                            <pre class="brush: xml">
                                <bettypes>
                                    <type id="1" t="ah" te="讓球" tt="" ts="让球"></type>
                                    <type id="3" t="ou" te="大小盤" tt="" ts="大小盘"></type>
                                    <type id="2" t="oe" te="單雙盤" tt="" ts="单双盘"></type>
                                </bettypes>
                            </pre>
                        </div>
                        <div>
                            <div style="width:100%; padding-top: 15px;"><strong>Definition:</strong></div>
                            <ul>
                                <li>Link: <a target="_blank" href="@bettypeUrl">@bettypeUrl</a></li>
                                <li>id: XML tag for bet type ID</li>
                                <li>t: XML tag for the bet type</li>
                                <li>te: Bet type name in English</li>
                                <li>tt: Bet type name in Traditional Chinese</li>
                                <li>ts: Bet type name in Simplified Chinese</li>
                                <li>tb: Bet type name in Bahasa Indonesia</li>
                                <li>ta: Bet type name in Thai</li>
                                <li>tk: Bet type name in Korean</li>
                                <li>tv: Bet type name in Vietnamese</li>
                                <li>tj: Bet type name in Japanese</li>
                                <li>th: Bet type name in Hindi</li>
                            </ul>
                        </div>
                        <div style="height: 20px;"></div>
                    </div>
                    <div id="div_appendix_countries" class="content appendix">
                        @{
                            var countries = new ColumnModel<Country>
                            {
                                ColumnOne = (IEnumerable<Country>)ViewBag.CountriesCol1,
                                ColumnTwo = (IEnumerable<Country>)ViewBag.CountriesCol2,
                                ColumnThree = (IEnumerable<Country>)ViewBag.CountriesCol3
                            };
                        }
                        @await Html.PartialAsync("Appendix/_SupportedCountries", countries)
                    </div>
                    <div id="div_appendix_leagues" class="content appendix" style="height: 100%">
                        @{ string leagueUrl = Model.Domain + "/" + ViewBag.VirtualPath + ViewBag.UserName + "/" + "leagues.xml"; }
                        @await Html.PartialAsync("Appendix/_SupportedLeagues", leagueUrl)
                    </div>
                </div>
            </section>
        </div>
    </div>

    <script src="~/minify/js/help.min.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            SyntaxHighlighter.all();
        });
    </script>
</body>
</html>