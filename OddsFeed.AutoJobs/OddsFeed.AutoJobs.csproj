<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="App_Data\SpNames.xml" />
    <None Remove="App_Data\SpNames.KLDR.xml" />
    <None Remove="App_Data\SpNames.LOCAL.xml" />
    <None Remove="App_Data\SpNames.PROD.xml" />
    <None Remove="App_Data\SpNames.UAT.xml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="App_Data\SpNames.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="nlog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="App_Data\SpNames.KLDR.xml" />
    <Content Include="App_Data\SpNames.LOCAL.xml" />
    <Content Include="App_Data\SpNames.PROD.xml" />
    <Content Include="App_Data\SpNames.UAT.xml" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="logs\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OddsFeed.Core\OddsFeed.Core.csproj" />
    <ProjectReference Include="..\OddsFeed.Models\OddsFeed.Models.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fanex.Data" Version="4.2.3" />
    <PackageReference Include="Fanex.Data.Repository" Version="4.2.3" />
    <PackageReference Include="Fanex.Data.SqlServer" Version="4.2.3" />
    <PackageReference Include="Fanex.Logging.Extensions.Database" Version="1.0.8" />
  </ItemGroup>
</Project>