<configuration>
    <configSections>
        <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
        <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
        <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
        <sectionGroup name="bundleTransformer">
            <section name="core" type="BundleTransformer.Core.Configuration.CoreSettings, BundleTransformer.Core" />
        </sectionGroup>
    </configSections>

    <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension" resourcePath="App_Data/SpNames.xml" enableWatching="0" />
        </providers>
    </Fanex.Data.DbSettingProvider>

    <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.2.98.3:9099\msmq\private$\entlib" defaultCategory="XML-Odds-Feed-MNL" />

    <appSettings>
        <add key="webpages:Version" value="3.0.0.0" />
        <add key="ClientValidationEnabled" value="true" />
        <add key="UnobtrusiveJavaScriptEnabled" value="true" />
        <add key="aspnet:MaxJsonDeserializerMembers" value="150000" />
        <add key="TotalVersion" value="17" />
        <add key="Interval" value="20" />
        <!--Flag to disable UM Time-->
        <add key="IsDisableUMTimeFlag" value="false" />
        <!--SP for testing in UM Time-->
        <add key="SPTestingUMTime" value="Portal_BetDaq_InsertBet_V2" />
        <!--Flag to disable UM Time-->
        <add key="IsDisableUMTimeFlag" value="true" />
        <add key="Cache.Prefix" value="apollo" />
        <add key="Environment" value="Production" />
        <add key="FeedUrlPath" value="" />
        <add key="VirtualPathWebService" value="feeds" />
        <add key="LimitedOptions" value="5" />
        <add key="HighlightSportType" value="" />
        <add key="HighlightBetType" value="" />
        <add key="BetTypeSchemaPath" value="Bin\BetTypeSchema\BetTypes.json" />
        <add key="BetTypeDescriptionPath" value="Bin\BetTypeSchema\BetTypeDescriptions.json" />
        <add key="BetTypeSchemaKey" value="BetTypeSchemaKey" />
        <add key="Bucket.OddsFeed" value="oddsfeed" />
        <add key="Bucket.Outrights" value="outrights" />
        <add key="Bucket.LiveMatches" value="livematches" />
        <add key="Bucket.DeadMatches" value="deadmatches" />
        <add key="Bucket.Throttler" value="XOF-throttler" />
        <add key="Bucket.BlockList" value="XOF-blocklist" />
        <add key="Throttler.RequestLimit" value="300" />
        <add key="Throttler.TimeOutInSeconds" value="30" />
        <add key="Throttler.BlockTimeInSeconds" value="60" />
    </appSettings>
    <connectionStrings>
        <add name="DBODDSFEED.bodb_OddsFeed.wsv_nap" providerName="System.Data.SqlClient" connectionString="packet size=4096; Data Source=10.40.40.23;Asynchronous Processing=true;Initial Catalog=bodb_oddsfeed;integrated security=false;User Id=wsv_nap;Password=tGvQ81wDp57an/VkfWyADdrGgwl6B52sSewTPyTAFw4=;" />
        <add name="DBACC.bodb02.wsv_nap" connectionString="packet size=4096; Data Source=10.40.40.23;Asynchronous Processing=true;Initial Catalog=bodb02;integrated security=false;User Id=wsv_nap;Password=tGvQ81wDp57an/VkfWyADdrGgwl6B52sSewTPyTAFw4=;" providerName="System.Data.SqlClient" />
        <add name="DBPRO.bodb02.portal" connectionString="packet size=4096; Data Source=10.40.40.23;Asynchronous Processing=true;Initial Catalog=bodb02;integrated security=false;User Id=wsv_nap;Password=tGvQ81wDp57an/VkfWyADdrGgwl6B52sSewTPyTAFw4=;" providerName="System.Data.SqlClient" />
    </connectionStrings>
    <system.web>
        <customErrors mode="Off" defaultRedirect="~/Errors/Index">
            <error statusCode="404" redirect="~/PageNotFound.html" />
        </customErrors>
        <compilation debug="false" targetFramework="4.6.1">
            <assemblies>
                <add assembly="System.Runtime, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
            </assemblies>
        </compilation>
        <authentication mode="Forms">
            <forms loginUrl="~/Account/LogOn" timeout="2880" />
        </authentication>
        <pages>
            <namespaces>
                <add namespace="System.Web.Helpers" />
                <add namespace="System.Web.Mvc" />
                <add namespace="System.Web.Mvc.Ajax" />
                <add namespace="System.Web.Mvc.Html" />
                <add namespace="System.Web.Routing" />
                <add namespace="System.Web.WebPages" />
            </namespaces>
        </pages>
    </system.web>
    <system.webServer>
        <validation validateIntegratedModeConfiguration="false" />
        <modules runAllManagedModulesForAllRequests="true" />
    </system.webServer>
    <runtime>
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
          <dependentAssembly>
            <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
            <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
          </dependentAssembly>
          <dependentAssembly>
            <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
            <bindingRedirect oldVersion="0.0.0.0-5.2.3.0" newVersion="5.2.3.0" />
          </dependentAssembly>
          <dependentAssembly>
            <assemblyIdentity name="System.Runtime.InteropServices.RuntimeInformation" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
            <bindingRedirect oldVersion="0.0.0.0-4.0.1.0" newVersion="4.0.1.0" />
          </dependentAssembly>
          <dependentAssembly>
            <assemblyIdentity name="System.IO.Compression" publicKeyToken="b77a5c561934e089" culture="neutral" />
            <bindingRedirect oldVersion="0.0.0.0-4.1.2.0" newVersion="4.1.2.0" />
