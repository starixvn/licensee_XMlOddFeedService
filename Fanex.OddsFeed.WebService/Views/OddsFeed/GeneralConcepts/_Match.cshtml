@using Fanex.OddsFeed.Common.DTO
@using Fanex.OddsFeed.Common.Schemas
@model UserProfile
@{
    var betTypeDescriptions = (IList<BetTypeDescription>)ViewBag.BetTypeDescriptions;
}

<span class="sub_title">TERM AND DEFINITION FOR MATCH</span>
<hr />
<ul>
    <li>Lastupdate: last request date for Odds data. </li>
    <li>Timestamp: last request date convert to integer number. </li>
    <li>ge: Event\League name in English. </li>
    <li>gs: Event\League name in Chinese Simplified. </li>
    <li>gt: Event\League name in Chinese Traditional. </li>
    <li>gb: Event\League name in Bahasa Indonesia.</li>
    <li>ga: Event\League name in Thai.</li>
    <li>gk: Event\League name in Korean.</li>
    <li>gv: Event\League name in Vietnamese.</li>
    <li>gj: Event\League name in Japanese.</li>
    <li>gh: Event\League name in Hindi.</li>
    <li>he: Home team name in English. </li>
    <li>hs: Home team name in Chinese Simplified. </li>
    <li>ht: Home team name in Chinese Traditional. </li>
    <li>hb: Home team name in Bahasa Indonesia.</li>
    <li>ha: Home team name in Thai.</li>
    <li>hk: Home team name in Korean.</li>
    <li>hv: Home team name in Vietnamese.</li>
    <li>hj: Home team name in Japanese.</li>
    <li>hh: Home team name in Hindi.</li>
    <li>ae: Away team name in English. </li>
    <li>as: Away team name in Chinese Simplified. </li>
    <li>at: Away team name in Chinese Traditional. </li>
    <li>ab: Away team name in Bahasa Indonesia.</li>
    <li>aa: Away team name in Thai.</li>
    <li>ak: Away team name in Korean.</li>
    <li>av: Away team name in Vietnamese.</li>
    <li>aj: Away team name in Japanese.</li>
    <li>ah: Away team name in Hindi.</li>
    <li>mt: Match Kick-off time </li>
    @if (Model.OddsType.Contains(4))
    {
        <li>runing: Status (Live or Dead Ball) </li>
    }
    <li>bookie name: Provider of XML Odds Feed in English. </li>
    <li>simp: Provider of XML Odds Feed in Chinese Simplified </li>
    <li>trad: Provider of XML Odds Feed in Chinese Simplified </li>
    <li>time: Display time for this odd. </li>
    @Html.Partial("_BettypeDescription")

    @foreach (BetTypeDescription bettypeDesc in betTypeDescriptions)
    {
        if (Model.BetTypes == null || Model.BetTypes.Contains(bettypeDesc.BetTypeId))
        {
            @Html.Partial("_BettypeDesc", bettypeDesc)
        }
    }
</ul>
<div style="color:Red">Note: When price is zero, it means we don't offer that bet choice.</div>
<div style="height: 20px"></div>