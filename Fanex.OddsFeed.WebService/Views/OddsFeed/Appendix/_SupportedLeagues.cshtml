@model string
<span class="sub_title">SUPPORTED LEAGUES</span>
<hr />
<div class="div_appendix_sports">
    To get the latest list of leagues for XML Odds Feed data, refer to below information:
    <pre class="brush: xml">
        <leagues>
            <league id="3202" sid="1" se="Soccer" ge="Golf - PGA Tour" gt="高尔夫球 - 美洲赛" gs="高爾夫球 -  美洲賽"></league>
        </leagues>
    </pre>
</div>
<div>
    <div style="width:100%; padding-top: 15px;"><strong>Definition:</strong></div>
    <ul>
        <li>Link: <a target="_blank" href="@Model">@Model</a></li>
        <li>sid: Sport ID</li>
        <li>se: Sport name in English</li>
        <li>ge: League name in English</li>
        <li>gt: League name in Traditional Chinese</li>
        <li>gs: League name in Simplified Chinese</li>
        <li>gb: League name in Bahasa Indonesia</li>
        <li>ga: League name in Thai</li>
        <li>gk: League name in Korean</li>
        <li>gv: League name in Vietnamese</li>
        <li>gj: League name in Japanese</li>
        <li>gh: League name in Hindi</li>
    </ul>
</div>
<div style="height: 20px;"></div>