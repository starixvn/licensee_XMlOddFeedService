@model Fanex.OddsFeed.Common.Schemas.BetTypeDescription
<li>
    t="@Model.Tag": @Model.BetTypeName
    <ul>
        @foreach (var betchoice in Model.BetChoices)
        {
            <li>@betchoice.Attribute: @betchoice.Description </li>
        }
        @if (Model.ExtraDescription != string.Empty)
        {
            <li>@Html.Raw(@Model.ExtraDescription)</li>
        }
    </ul>
</li>