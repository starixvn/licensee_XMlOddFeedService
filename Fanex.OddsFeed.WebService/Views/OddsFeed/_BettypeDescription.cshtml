@model Fanex.OddsFeed.Common.DTO.UserProfile
@if (Model.BetTypes == null || Model.BetTypes.Contains(1))
{
    <li>
        t="ah" : Full time Asian Handicap bet type
        <ul>
            <li>h: Handicap line </li>
            <li>o: Price for home team </li>
            <li>u: Price for away team </li>
            <li>
                For indication of handicap “h”, please show the handicap for the favorite team, use
                “+” or “-” to indicate the home team is the favorite or underdog i.e.
            </li>
        </ul>
    </li>
    <div style="text-indent: 70px;">
        + When h<=0, the home team is the favorite.<br />
    </div>
    <div style="text-indent: 70px;">
        + When h>0, the away team is the favorite.
    </div>
}
